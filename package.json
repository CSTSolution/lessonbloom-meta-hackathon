{
  "name": "lessonbloom-meta",
  "version": "0.1.0",
  "private": true,
  "description": "LessonBloom on Meta's models: a primary teacher's notes become a lesson, practice and a learning summary. Meta Global AI Developer Hackathon 2026.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/main.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "tsc --noEmit && tsc --noEmit -p web && tsx --test --test-concurrency=2 --test-timeout=120000 test/*.test.ts",
    "test:render": "tsx --test --test-timeout=300000 test/render/*.test.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.1.1",
    "@hono/node-server": "^2.1.5",
    "@meta-sam/parser": "0.1.0",
    "aws4fetch": "1.0.20",
    "hono": "^4.13.13",
    "jpeg-js": "0.4.4",
    "nodemailer": "^6.9.16",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
