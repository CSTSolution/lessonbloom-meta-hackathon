# What the server reads from its ENVIRONMENT (the app never loads this file; it is a list).
# On the server these go in a .env file readable only by its owner (chmod 600); see deploy/README.md.

# Postgres. Unset: an in-process Postgres (PGlite) under LB_DATA_DIR, for local development only.
# DATABASE_URL=postgres://lessonbloom_meta:...@postgres:5432/lessonbloom_meta?sslmode=no-verify

# Meta Model API, server only. Unset: the offline mock.
# MODEL_API_KEY=

# Narration from self-hosted voice engines (Meta has no text-to-speech)
# VIENEU_URL=http://vieneu:8086
# KOKORO_URL=http://kokoro:8083

# Email sign-in codes (Brevo). Unset: codes are printed to the server log (development).
# SMTP_SERVER= SMTP_PORT=587 SMTP_USER= SMTP_KEY= MAIL_FROM=no-reply@cstsolution.com MAIL_FROM_NAME=LessonBloom

# Guard: global AI budget per day (USD) and a kill switch
# LB_DAY_USD=20
# AI_DISABLED=1
# LB_ADMIN_KEY=          (admin routes; long random)
